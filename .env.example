# ============================================================
# Lab 3-3 环境变量配置模板
# ============================================================
# 复制本文件为 .env（不要提交 .env 到 git）
# 本地开发: 创建 .env 文件填入真实 Key
# 云端部署: 在 CloudBase 控制台 → 云函数 → 环境变量 中配置

# --- GLM / 智谱 AI ---
# glm api 密钥（secret）
GLM_SECRET=------
# glm api key（id.secret 格式）
GLM_API_KEY=------

# --- 高德地图 ---
# 高德地图 Web 端 JS API key（前端使用，可暴露）
AMAP_JS_KEY=------
# 高德地图 Web 端 JS API 密钥
AMAP_SECURITY_JS_CODE=------
# 高德地图 Web 服务 API key（后端使用，必须保密）
AMAP_WEB_SERVICE_KEY=------

# --- 数据库 ---
# SQLite 数据库文件路径（可选，默认 backend/data/app.db）
# APP_DB_PATH=/path/to/app.db
