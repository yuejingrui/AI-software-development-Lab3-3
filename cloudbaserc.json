{
  "version": "2.0",
  "envId": "lab3-3-d5gdcm7qo10ced8af",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "api",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "include": [
        "common/errors.js",
        "common/response.js",
        "common/secrets.js",
        "common/db.js",
        "common/utils.js"
      ],
      "envVariables": {
        "APP_DB_PATH": "{{env.APP_DB_PATH}}",
        "GLM_SECRET": "{{env.GLM_SECRET}}",
        "GLM_API_KEY": "{{env.GLM_API_KEY}}",
        "AMAP_JS_KEY": "{{env.AMAP_JS_KEY}}",
        "AMAP_SECURITY_JS_CODE": "{{env.AMAP_SECURITY_JS_CODE}}",
        "AMAP_WEB_SERVICE_KEY": "{{env.AMAP_WEB_SERVICE_KEY}}"
      }
    }
  ]
}
